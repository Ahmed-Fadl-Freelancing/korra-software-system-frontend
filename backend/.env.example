# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Supabase Postgres (direct connection)
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase Auth – JWT verification (HS256 secret from Supabase dashboard > Settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Storage – server-side signed URLs (service_role key, NEVER expose to client)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS – frontend origin
NEXTJS_ORIGIN=http://localhost:5173

# UiPath webhook (optional)
# UIPATH_SHARED_SECRET=optional-shared-secret
