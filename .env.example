# Korra Frontend — Environment Variables
# Copy this file to `.env` and fill in the actual values

# Django Backend API (the ONLY service this frontend talks to)
VITE_DJANGO_API_BASE_URL=http://localhost:8000

# Linear API — for direct issue/milestone management
VITE_LINEAR_API_KEY= 

# Feature Flags (optional)
VITE_USE_STUBS=false
VITE_ENABLE_DEBUG_TOOLS=false
